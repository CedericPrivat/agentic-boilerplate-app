# Database credentials
DATABASE_URL=postgresql://user:password@localhost:5432/dev

# Authentication
BETTER_AUTH_SECRET=your-secret-here-min-32-chars-long
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com
EMAIL_DEV_PORT=3002

# Uptime Kuma (monitoring)
UPTIME_KUMA_PORT=3001
UPTIME_KUMA_URL=http://localhost:$UPTIME_KUMA_PORT

# Umami Analytics
UMAMI_PORT=3003
UMAMI_APP_SECRET=replace-me-with-a-random-string
NEXT_PUBLIC_UMAMI_URL=http://localhost:$UMAMI_PORT
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Sentry
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
